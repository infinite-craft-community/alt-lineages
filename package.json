{
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ]
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "build": "bun --cwd ./apps/userscript build",
    "deploy": "bun run --filter './apps/**' deploy"
  },
  "devDependencies": {
    "@gameroman/config": "0.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
